rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['username', 'email']) && data.username is string && data.username.size() <= 100;
    }
    
    // We allow simple rule matching for the 38 collections
    // Since our backend uses Admin SDK which bypasses these, these rules secure direct client access if any.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().keys().hasOnly(['username', 'email', 'created_at']);
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'bio', 'location', 'avatar']);
      allow delete: if isAdmin();
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }
    
    // Default open for the rest of collections for now, locked down to signed in users.
    // Full 8-pillar implementations are complex and typically required per collection.
    match /riders/{id} { allow read, write: if isSignedIn(); }
    match /motorcycles/{id} { allow read, write: if isSignedIn(); }
    match /ecosystems/{id} { allow read, write: if isSignedIn(); }
    match /posts/{id} { allow read, write: if isSignedIn(); }
    match /post_likes/{id} { allow read, write: if isSignedIn(); }
    match /followers/{id} { allow read, write: if isSignedIn(); }
    match /events/{id} { allow read, write: if isSignedIn(); }
    // Staging de ingestão de eventos: só admin lê; nenhum cliente escreve.
    // Escrita é exclusiva do serviço de ingestão e do backend via Admin SDK
    // (que ignora estas regras). A aprovação move o doc para /events.
    match /events_staging/{id} { allow read: if isAdmin(); allow write: if false; }
    // Relatos de Estrada (Fase 0). Public reads: only approved/featured. The author
    // reads their own in any status; admins read everything. ALL writes go through
    // the backend (Admin SDK, which bypasses these rules) — clients can never set
    // status/verificationLevel/qualitySignals/origin/featured*. These rules are
    // defense in depth for any direct client access. moderationNotes is admin-only.
    match /relatos/{id} {
      allow read: if existing().status in ['approved', 'featured']
                   || isAdmin()
                   || isOwner(string(existing().authorId));
      allow write: if false;
    }
    // User-submitted place candidates pending moderation: admin-only, like staging.
    match /places_staging/{id} { allow read: if isAdmin(); allow write: if false; }
    // Routes (built in Fase 5): read gated by privacyLevel; writes via Admin SDK.
    match /routes/{id} {
      allow read: if existing().privacyLevel == 'public'
                   || (isSignedIn() && existing().privacyLevel == 'community')
                   || isAdmin();
      allow write: if false;
    }
    match /contests/{id} { allow read, write: if isSignedIn(); }
    match /submissions/{id} { allow read, write: if isSignedIn(); }
    match /votes/{id} { allow read, write: if isSignedIn(); }
    match /notifications/{id} { allow read: if isOwner(existing().user_id) || (incoming() != null && isOwner(incoming().user_id)); allow write: if isSignedIn(); }
    match /event_rsvps/{id} { allow read, write: if isSignedIn(); }
    match /keywords_config/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /places_cache/{id} { allow read, write: if isSignedIn(); }
    match /places_control/{id} { allow read, write: if isSignedIn(); }
    match /event_photos/{id} { allow read, write: if isSignedIn(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /ambassadors/{id} { allow read, write: if isSignedIn(); }
    match /passport_stamps/{id} { allow read, write: if isSignedIn(); }
    match /user_passport_stamps/{id} { allow read, write: if isSignedIn(); }
    match /badges/{id} { allow read, write: if isSignedIn(); }
    match /user_badges/{id} { allow read, write: if isSignedIn(); }
    match /maintenance_logs/{id} { allow read, write: if isSignedIn(); }
    match /comments/{id} { allow read, write: if isSignedIn(); }
    match /checkins/{id} { allow read, write: if isSignedIn(); }
    match /ambassador_posts/{id} { allow read, write: if isSignedIn(); }
    match /social_walls/{id} { allow read, write: if isSignedIn(); }
    match /recommendations/{id} { allow read, write: if isSignedIn(); }
    match /discovered_routes/{id} { allow read, write: if isSignedIn(); }
    match /rating_summaries/{id} { allow read, write: if isSignedIn(); }
    match /reviews/{id} { allow read, write: if isSignedIn(); }
    match /review_verifications/{id} { allow read, write: if isSignedIn(); }
    match /checkpoints/{id} { allow read, write: if isSignedIn(); }
    match /user_route_progress/{id} { allow read, write: if isSignedIn(); }
    match /club_memberships/{id} { allow read, write: if isSignedIn(); }
    match /ambassador_applications/{id} { allow read, write: if isSignedIn(); }
  }
}
